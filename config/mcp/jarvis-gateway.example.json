{
  "mcpServers": {
    "jarvis": {
      "command": "node",
      "args": ["D:/JARVIS/jarvis-mcp-gateway/src/server.js"],
      "env": {
        "JARVIS_ROOT": "D:/JARVIS",
        "JARVIS_WORKSPACE_ROOT": "D:/",
        "JARVIS_AUDIT_LOG": "D:/JARVIS/logs/mcp-audit.jsonl",
        "JARVIS_PROVIDER_ORDER": "codex,opencode-go,ollama-cloud,openrouter"
      }
    }
  }
}
